# PostgreSQL Veritabanı Bağlantı Bilgileri
DB_HOST=your-database-host.neon.tech
DB_PORT=5432
DB_NAME=your-database-name
DB_USER=your-database-user
DB_PASS=your-database-password

# JWT Secret Key (rastgele güçlü bir string kullanın)
JWT_SECRET=your-secret-key-here-min-32-characters-long

# Server Port
PORT=5000
